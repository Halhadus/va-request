#include "compat/compat.h"
@COMPAT_DECLARATIONS@
static const struct vav4l2_compat_module *const modules[] = {
@COMPAT_ENTRIES@
    NULL
};
const struct vav4l2_compat_module *const *vav4l2_compat_modules(size_t *count)
{
    *count = sizeof(modules) / sizeof(modules[0]) - 1;
    return modules;
}
